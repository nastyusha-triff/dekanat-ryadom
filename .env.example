# Для Docker Compose укажите свой домен, DNS которого направлен на сервер.
DOMAIN=portal.example.com
# Для локального Node-сервера (не требуется для localhost):
# PUBLIC_ORIGIN=https://portal.example.com
# DB_PATH=/absolute/path/portal.sqlite
# HOST=0.0.0.0
# PORT=8787
# ADMIN_TOKEN задается только в окружении сервера, если нужен служебный HTTP API.
